		 WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(10));

		    // Click on the "From" span to reveal the input field
		    wait.until(ExpectedConditions.elementToBeClickable(FromOneWay)).click();

		    // After clicking, find the input that appears and send keys
		    WebElement fromInput = wait.until(ExpectedConditions.visibilityOfElementLocated(
		        By.xpath("//span[contains(text(),'From')]/following::input[1]")));

		    // Use JavaScript in case normal sendKeys doesn't work due to styling/autocomplete interference
		    String fromCity = prop.getProperty("FromCity");
		    ((JavascriptExecutor) driver).executeScript("arguments[0].value = arguments[1];", fromInput, fromCity);

		    // Optionally trigger an input event to activate suggestions
		    ((JavascriptExecutor) driver).executeScript(
		        "arguments[0].dispatchEvent(new Event('input', { bubbles: true }));", fromInput);

		    // Wait for the suggestion to appear and click it
		    WebElement sugg = wait.until(ExpectedConditions.elementToBeClickable(puneOption));
		    ((JavascriptExecutor) driver).executeScript("arguments[0].click();", sugg);

		
	}
	
