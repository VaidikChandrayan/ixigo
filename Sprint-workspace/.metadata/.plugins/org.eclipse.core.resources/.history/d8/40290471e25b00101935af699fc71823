////        wait.until(ExpectedConditions.visibilityOf(puneOption)).click();
////        WebElement sugg = wait.until(ExpectedConditions.elementToBeClickable(puneOption));
//        ((JavascriptExecutor) driver).executeScript("arguments[0].click();", sugg);
		
	    WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(10));

	    // Click on the "From" span to activate the input field
	    wait.until(ExpectedConditions.elementToBeClickable(FromOneWay)).click();

	    // Locate the actual input field
	    WebElement fromInput = wait.until(ExpectedConditions.visibilityOfElementLocated(
	        By.xpath("//span[contains(text(),'From')]/following::input[1]")));

	    // Clear any pre-filled value
	    fromInput.clear();

	    // Use Actions to simulate keystrokes instead of JavaScript for autocomplete trigger
	    Actions actions = new Actions(driver);
	    actions.moveToElement(fromInput).click().sendKeys(prop.getProperty("FromCity")).perform();

	    // Wait for the suggestion to be clickable and click using JS in case it's still behind UI overlays
	    WebElement sugg = wait.until(ExpectedConditions.elementToBeClickable(puneOption));
	    ((JavascriptExecutor) driver).executeScript("arguments[0].scrollIntoView(true);", sugg);
	    ((JavascriptExecutor) driver).executeScript("arguments[0].click();", sugg);

         
		
	}
	
	public void sameTo()
	{
		 WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(10));

		    // Click on the 'ToOneWay' input box
		    wait.until(ExpectedConditions.elementToBeClickable(ToOneWay)).click();
		    
		    // Type into the input
		    ToOneWay.sendKeys(prop.getProperty("FromCity"));

		    // Wait a little to ensure dropdown loads suggestions
		    try {
		        Thread.sleep(1000); // Can be replaced with a more robust wait, if needed
		    } catch (InterruptedException e) {
		        e.printStackTrace();
		    }

		    // Wait for the specific option (e.g. Pune) to be visible and clickable
		    WebElement sugg = wait.until(ExpectedConditions.visibilityOf(puneOption));
		    wait.until(ExpectedConditions.elementToBeClickable(puneOption));

		    // Scroll the element into view and click it using JavaScript
		    ((JavascriptExecutor) driver).executeScript("arguments[0].scrollIntoView(true);", sugg);
		    ((JavascriptExecutor) driver).executeScript("arguments[0].click();", sugg);


	}
	
	

}
