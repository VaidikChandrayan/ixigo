	public void fromData1()
	{
       Actions actions = new Actions(driver);
       FromOneWay.click();
    actions.sendKeys(prop.getProperty("FromCity")).pause(Duration.ofSeconds(1)).perform();

    WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(10));
    WebElement sugg = wait.until(ExpectedConditions.elementToBeClickable(puneOption));
    sugg.click();
	}

	public void ToData1() {
	    WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(15));

	    // Step 1: Wait for the "To" input field and click it
	    WebElement toInput = wait.until(ExpectedConditions.elementToBeClickable(
	        By.xpath("//span[contains(text(),'To')]/following::input[1]")));
	    toInput.click();

	    // Step 2: Type into the field to simulate user input (better than setting with JS)
	    toInput.sendKeys("PNQ-Pune");

	    // Optional: pause briefly to let frontend update (try to avoid sleep if possible)
	    try {
	        Thread.sleep(2000); // sometimes necessary if no JS events are triggered
	    } catch (InterruptedException e) {
	        e.printStackTrace();
	    }

	    // Step 3: Wait for the suggestion dropdown to show the desired result
	    List<WebElement> options = wait.until(ExpectedConditions.presenceOfAllElementsLocatedBy(
	        By.xpath("//li[contains(text(),'Pune')]")));

	    System.out.println("Suggestions found: " + options.size());

	    // Step 4: Click the first matching suggestion using JavaScript (to avoid ElementClickInterceptedException)
	    if (!options.isEmpty()) {
	        ((JavascriptExecutor) driver).executeScript("arguments[0].click();", options.get(0));
	    } else {
	        System.out.println("No suggestions found for 'Pune'.");
	    }
	}


