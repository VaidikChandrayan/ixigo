	public String[] loginReader(String filename) throws IOException {
        String path = "C:\\Sprint-workspace\\ixigo\\src\\test\\resource\\Exceldata\\" + filename;
        String[] cred = new String[2];

        try (FileInputStream fis = new FileInputStream(new File(path));
             Workbook workbook = new XSSFWorkbook(fis)) {

            Sheet sheet = workbook.getSheetAt(0);
            Row row = sheet.getRow(1); // Second row (index starts at 0)

            if (row == null) throw new IllegalArgumentException("Row 1 is missing.");

            Cell cell0 = row.getCell(0);
            Cell cell1 = row.getCell(1);

            if (cell0 == null || cell1 == null) throw new IllegalArgumentException("Missing cell data.");

            cred[0] = cell0.getStringCellValue();
            cred[1] = cell1.getStringCellValue();



   }
