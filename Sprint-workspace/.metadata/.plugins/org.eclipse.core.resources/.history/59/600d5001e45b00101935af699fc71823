public class FlightNegativeDataPage extends BasePage {
	
	
	

	public FlightNegativeDataPage(WebDriver driver) {
		super(driver);
		this.driver = driver;
		PageFactory.initElements(driver, this);
		
	}
	
	public void sameFrom()
	{
