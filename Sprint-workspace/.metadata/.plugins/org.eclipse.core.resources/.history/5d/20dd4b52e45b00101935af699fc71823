	public void sameTo()
	{
		    WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(10));
		    
		    wait.until(ExpectedConditions.elementToBeClickable(ToOneWay)).click();
		    ToOneWay.sendKeys(prop.getProperty("FromCity"));

		    // Wait for the element to appear in the DOM
		    WebElement sugg = wait.until(ExpectedConditions.presenceOfElementLocated(By.xpath("//span[contains(text(),'Pune')]")));

		    // Scroll and click via JS (ensures visibility and interaction)
		    ((JavascriptExecutor) driver).executeScript("arguments[0].scrollIntoView(true);", sugg);
		    ((JavascriptExecutor) driver).executeScript("arguments[0].click();", sugg);
