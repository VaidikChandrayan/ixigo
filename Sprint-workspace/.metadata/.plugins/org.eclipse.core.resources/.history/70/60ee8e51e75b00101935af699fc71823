		 WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(10));

		    // Step 1: Click the 'From' field to activate the input
		    wait.until(ExpectedConditions.elementToBeClickable(FromOneWay)).click();

		    // Step 2: Target the actual input element
		    WebElement input = wait.until(ExpectedConditions.visibilityOfElementLocated(
		        By.xpath("//span[contains(text(),'From')]/following::input[1]")));

		    input.clear(); // Clear existing text
		    input.sendKeys(prop.getProperty("FromCity")); // Type the city (e.g., Pune)

		    // Step 3: Wait for dropdown suggestions to populate
		    wait.until(ExpectedConditions.presenceOfElementLocated(By.xpath("//ul//li")));

		    // Step 4: Loop through suggestions and click the one with "Pune"
		    List<WebElement> options = driver.findElements(By.xpath("//ul//li"));
		    for (WebElement option : options) {
		        if (option.getText().toLowerCase().contains("pune")) {
		            ((JavascriptExecutor) driver).executeScript("arguments[0].scrollIntoView(true);", option);
		            ((JavascriptExecutor) driver).executeScript("arguments[0].click();", option);
		            return;
		        }
		    }

		}


         
		
	
	
