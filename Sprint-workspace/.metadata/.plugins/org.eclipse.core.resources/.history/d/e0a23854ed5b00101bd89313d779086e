	public void sameTo() {
	    WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(10));

	    // Step 1: Click on the 'To' field to activate the input
	    wait.until(ExpectedConditions.elementToBeClickable(ToOneWay)).click();

	    // Step 2: Locate and type into the actual input field
	    WebElement input = wait.until(ExpectedConditions.visibilityOfElementLocated(
	        By.xpath("//span[contains(text(),'To')]/following::input[1]")));
	    input.clear();
	    input.sendKeys(prop.getProperty("ToCity")); // e.g., "Pune"

	    // Step 3: Wait for the dropdown option for Pune to appear
	    WebElement puneOption = wait.until(ExpectedConditions.presenceOfElementLocated(
	        By.xpath("//span[contains(@class,'truncate') and contains(normalize-space(translate(., '\"', '')), 'Pune')]")));

	    // Step 4: Click the Pune option
	    ((JavascriptExecutor) driver).executeScript("arguments[0].click();", puneOption);

	    // Step 5: Give UI time to process the selection and trigger validation
	    try {
	        Thread.sleep(500); // Adjust if needed based on UI delay
	    } catch (InterruptedException e) {
	        Thread.currentThread().interrupt();
	    }

	    // Step 6: Explicitly blur the input field to prevent dropdown reopening
	    ((JavascriptExecutor) driver).executeScript("arguments[0].blur();", input);
	}
	

