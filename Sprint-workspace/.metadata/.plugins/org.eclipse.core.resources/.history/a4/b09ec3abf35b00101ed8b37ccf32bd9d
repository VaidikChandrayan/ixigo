		public void sameTo() {
		    WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(10));

		    // Step 1: Click the 'To' field to focus
		    wait.until(ExpectedConditions.elementToBeClickable(ToOneWay)).click();

		    // Step 2: Locate the input for 'To' and type the same value as 'FromCity'
		    WebElement input = wait.until(ExpectedConditions.visibilityOfElementLocated(
		        By.xpath("//span[contains(text(),'To')]/following::input[1]")));
		 //   input.clear();
		    input.sendKeys(prop.getProperty("ToCitySame"));  // e.g., "Pune"

		    // Step 3: Wait for the dropdown suggestion for "Pune" to appear and become clickable
		    WebElement puneOption = wait.until(ExpectedConditions.elementToBeClickable(
		        By.xpath("//*[contains(text(),'Pune') and contains(@class,'truncate')]")));

		    // Step 4: Click the "Pune" suggestion using JavaScript
		    ((JavascriptExecutor) driver).executeScript("arguments[0].click();", puneOption);

		    // Step 5: Allow time for UI validation (e.g., error message to appear)
		    try {
		        Thread.sleep(500);  // Adjust if needed for your app's responsiveness
		    } catch (InterruptedException e) {
		        Thread.currentThread().interrupt();
		    }

		    // Step 6: Blur the input to avoid re-triggering the dropdown
		    ((JavascriptExecutor) driver).executeScript("arguments[0].blur();", input);

		    // Optional: Log presence of error message for debugging
		    try {
		        WebElement errorMsg = wait.until(ExpectedConditions.visibilityOfElementLocated(
		            By.xpath("//*[contains(text(),'cannot') or contains(text(),'same city')]")));
		        System.out.println("Validation message shown: " + errorMsg.getText());
		    } catch (TimeoutException e) {
		        System.out.println("No validation message found.");
		    }
		}

