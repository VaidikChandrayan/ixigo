package com.pages;

import java.time.Duration;
import java.util.Set;

import org.openqa.selenium.*;
import org.openqa.selenium.interactions.Actions;
import org.openqa.selenium.support.FindBy;
import org.openqa.selenium.support.PageFactory;
import org.openqa.selenium.support.ui.*;

public class FilterDataPage extends BasePage {
    WebDriver driver;
    WebDriverWait wait;

//    @FindBy(xpath = "//p[contains(text(),'Air India')]/ancestor::div[contains(@class,'flex')]//input[@type='checkbox' and @value='AI']")
//    WebElement airIndiaCheckbox;
    WebElement airIndiaCheckbox = driver.findElement(By.xpath("//p[contains(text(),'Air India')]/ancestor::div[contains(@class,'flex')]//input[@type='checkbox' and @value='AI']"));

    public FilterDataPage(WebDriver driver) {
        super(driver);
        this.driver = driver;
        this.wait = new WebDriverWait(driver, Duration.ofSeconds(10));
        PageFactory.initElements(driver, this);
    }

    public void filter() {
        // 🔄 Switch to newly opened tab
        String originalWindow = driver.getWindowHandle();
        Set<String> allWindows = driver.getWindowHandles();

        for (String handle : allWindows) {
            if (!handle.equals(originalWindow)) {
                driver.switchTo().window(handle);
                System.out.println("✅ Switched to new tab: " + driver.getTitle());
                break;
            }
        }

        try {
            // 🖱️ Scroll into view
            ((JavascriptExecutor) driver).executeScript("arguments[0].scrollIntoView(true);", airIndiaCheckbox);
            System.out.println("🔍 Scrolled to Air India filter");

            // ❌ Dismiss popup
            new Actions(driver).moveByOffset(10, 10).click().perform();
            System.out.println("❌ Dismissed popup by clicking outside");

            // ⏳ Wait and click
            wait.until(ExpectedConditions.elementToBeClickable(airIndiaCheckbox));
            airIndiaCheckbox.click();
            System.out.println("✅ Air India filter applied");

        } catch (Exception e) {
            System.out.println("⚠️ Error while applying filter: " + e.getMessage());
        }
    }
}