package com.pages;

import java.util.Set;

import org.openqa.selenium.By;
import org.openqa.selenium.JavascriptExecutor;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.interactions.Actions;
import org.openqa.selenium.support.FindBy;
import org.openqa.selenium.support.PageFactory;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

public class FilterDataPage extends BasePage{
	 public FilterDataPage(WebDriver driver) {
		super(driver);
		this.driver = driver;
		PageFactory.initElements(driver, this);
		WebDriverWait wait;
}


   public void filter() {
	   
	   String original = driver.getWindowHandle();
       Set<String> allWindows = driver.getWindowHandles();

       for (String windowHandle : allWindows) {
           if (!windowHandle.equals(original)) {
               driver.switchTo().window(windowHandle);
               break;
           }
       }
    // Optional wait until the filter section loads
    //   wait.until(ExpectedConditions.visibilityOfElementLocated(filterSection));
         
       
       // Scroll into view
       WebElement checkbox = driver.findElement((By) airIndiaCheckbox);
       ((JavascriptExecutor) driver).executeScript("arguments[0].scrollIntoView(true);", checkbox);

       // Dismiss any popup by clicking at (10,10)
       new Actions(driver).moveByOffset(10, 10).click().perform();

       // Wait until it's clickable
       wait.until(ExpectedConditions.elementToBeClickable(checkbox));

       // Click the checkbox
       checkbox.click();

       

	   
	   
   }
    
	
	
}
