package com.pages;

import java.util.List;

import org.openqa.selenium.WebDriver;

import io.cucumber.datatable.DataTable;

public class TrainFilterPage extends BasePage{
	
	public TrainFilterPage(WebDriver driver) {
		super(driver);
		// TODO Auto-generated constructor stub
	}

	public void clickFilter(DataTable dataTable)
	{	
		List<Map<String , String>> data = dataTable.asMaps(String.class, String.class);
		int row = Integer.parseInt(data.get(0).get("row"));
		int quotaCol = Integer.parseInt(data.get(0).get("quotaCol"));
		int classCol = Integer.parseInt(data.get(0).get("classCol"));
		
		String excelPath = prop.getProperty("excelPath");
		ExcelReader reader = new ExcelReader(excelPath);
		
		String quotaValue = reader.getCellData(row, quotaCol).trim();
		String classValue = reader.getCellData(row, classCol).trim();
		
		String quotaXpath = "//span[contains(text(),'"+ quotaValue +"')]";
		
		WebElement quotaElement = wait.until(ExpectedConditions.elementToBeClickable(By.xpath(quotaXpath)));
		quotaElement.click();
		

		String classXpath = "//span[contains(text(),'"+ classValue +"')]";
		
		WebElement classElement = wait.until(ExpectedConditions.elementToBeClickable(By.xpath(classXpath)));
		classElement.click();
				
	}
	

}
