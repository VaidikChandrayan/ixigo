	public void clickFilter(DataTable dataTable)
	{
		List<Map<String, String>> data = dataTable.asMaps(String.class,String.class);
		
		int row = Integer.parseInt(data.get(0).get("row"));
		int qoutaCol = Integer.parseInt(data.get(0).get("quotaCol"));
		int classCol = Integer.parseInt(data.get(0).get("classCol"));
		
		System.out.println("row: "+(data.get(0).get("row")));
		System.out.println("qouta: "+(data.get(0).get("quotaCol")));
		System.out.println("class: "+(data.get(0).get("classCol")));
		
		String qoutaValue = reader.getCellData(row, qoutaCol).trim();
		String classValue = reader.getCellData(row, classCol).trim();
		
		String qoutaPath = "//span[@class='label u-pos-rel u-ib u-v-align-top' and text() ='" + qoutaValue + "']";
		String classPath = "//span[@class='label u-ib u-pos-rel u-v-align-top' and text() ='" + classValue + "']";
		
		WebElement qoutaElement = wait.until(ExpectedConditions.elementToBeClickable(By.xpath(qoutaPath)));
		qoutaElement.click();
		
		WebElement classElement = wait.until(ExpectedConditions.elementToBeClickable(By.xpath(classPath)));
		classElement.click();
	}
