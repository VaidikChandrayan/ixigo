package com.pages;

public class BasePage {
	
	 WebDriver driver;
	    WebDriverWait wait;
	    JavascriptExecutor js;
	    Properties prop;

	    @FindBy(xpath = "//input[@placeholder='Enter Origin']")
	    WebElement fromField;

	    @FindBy(xpath = "//input[@placeholder='Enter Destination']")
	    WebElement toField;

	    @FindBy(xpath = "//div[contains(@class,'station-suggestion')]")
	    List<WebElement> stationSuggestions;

	    @FindBy(xpath = "//button[@data-testid='book-train-tickets']")
	    WebElement searchButton;

	    @FindBy(css = "abbr[aria-label='July 15, 2025']")
	    WebElement fixedDate;

	    @FindBy(xpath = "//div[contains(@class, 'train-list')]")
	    WebElement trainListContainer;

	    @FindBy(xpath = "(//button[contains(text(), 'Show Availability')])[1]")
	    WebElement availabilityButton;

	    @FindBy(css = "div.train-status-item")
	    List<WebElement> seatAvailabilityItems;

	    public BasePage(WebDriver driver) {
	        this.driver = driver;
	        PageFactory.initElements(driver, this);
	        this.wait = new WebDriverWait(driver, Duration.ofSeconds(10));
	        this.js = (JavascriptExecutor) driver;
	        loadProperties();
	    }

	    private void loadProperties() {
	        try {
	            prop = new Properties();
	            FileInputStream fis = new FileInputStream("C:\\Sprint-workspace\\ixigo\\src\\test\\resource\\PropertieFiles\\TrainSearch.properties");
	            prop.load(fis);
	        } catch (Exception e) {
	            System.err.println("Error loading properties: " + e.getMessage());
	        }
	    }

}
